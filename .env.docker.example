# Copy to .env.docker for `docker compose up`. Hostnames are compose service
# names (db, redis), not localhost. Never commit the real .env.docker.

DJANGO_SECRET_KEY=dev-only-not-secret-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the db service in docker-compose.yml
DATABASE_URL=postgresql://bolo_django:bolo_django@db:5432/bolo_django

JWT_SECRET=dev-only-not-secret-change-me
COOKIE_SECURE=False

# Matches the redis service in docker-compose.yml
REDIS_URL=redis://redis:6379/0

# Object storage / email / OpenAI -- left blank for local dev (S3 calls are
# mocked in tests; email falls back to the console backend; search runs its
# AI-unavailable fallback). Fill in for a real integration run.
S3_BUCKET_NAME=
AWS_S3_REGION=ap-south-1
SES_FROM_EMAIL=
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-4o-mini
