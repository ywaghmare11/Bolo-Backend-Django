# Keep the build context small and secret-free.
.git
.gitignore
.github
.venv
venv
env
ENV
__pycache__
*.py[cod]
*.so
.pytest_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
coverage.xml

# Secrets / local env -- never bake into an image
.env
.env.*
!.env.example
!.env.docker.example

# Docs and dev-only meta (not needed at runtime)
docs
*.md
!README.md
ROADMAP.md
changelog.md

# Local artifacts
staticfiles
static_root
media
celerybeat-schedule
celerybeat.pid
docker-compose.override.yml
